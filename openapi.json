    "/v1/student/attendance/daily": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Per-period attendance for one date",
        "description": "Every period of that weekday with attendance 'present' | 'absent' | null (null = not marked). This is the data behind the portal's 'Attendance: Present' / 'Attendance Not Marked' labels. `periods[]` contains only real class slots \u2014 empty grid holes are dropped and the LUNCH marker is omitted; `period` keeps the original grid position.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2026-11-14"
            },
            "description": "YYYY-MM-DD or DD-Mon-YYYY. Defaults to today."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DailyAttendance"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "BAD_DATE"
          }
        }
      }
    },
    "/v1/student/attendance/daily/history": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Daily attendance over a date range",
        "description": "One upstream call per date (max 31 days per request, concurrency 3). Sundays skipped. Returns each day plus per-subject present/absent totals. Defaults: `to` = today, `from` = 6 days earlier.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2026-11-09"
            },
            "required": false,
            "description": "Start date (defaults to 6 days before `to`)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2026-11-14"
            },
            "required": false,
            "description": "End date (defaults to today)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK, with days[] and bySubject[] and totals"
          },
          "400": {
            "description": "BAD_DATE / BAD_RANGE / RANGE_TOO_LARGE"
          }
        }
      }
    },
    "/v1/student/attendance/summary": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Cumulative attendance + month-by-month breakdown",
        "description": "The same figures the portal draws in its 'Cumulative Attendance' pie and its report totals row. Without `month` you get the cumulative totals plus a row for each of the 12 months (`monthsWithLectures` marks the ones that actually have lectures).",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "0/all = cumulative (default), 1-12, or a month name",
            "schema": {
              "type": "string",
              "example": "11"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "scope, present/absent/total/percent, byMonth[12]",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceSummaryReport"
                }
              }
            }
          },
          "400": {
            "description": "BAD_MONTH"
          }
        }
      }
    },
    "/v1/student/attendance/by-subject": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Per-subject attendance totals (optionally one month)",
        "description": "One row per registered subject with present/absent/total/percent, a running `overall` total, and a `byType` split of theory vs lab. Subjects with no marked lectures come back with `total: 0` and `percent: null` instead of being dropped.",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "0/all = cumulative (default), 1-12, or a month name",
            "schema": {
              "type": "string",
              "example": "11"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "subjects[], overall, byType{theory,lab}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectAttendanceReport"
                }
              }
            }
          },
          "400": {
            "description": "BAD_MONTH"
          }
        }
      }
    },
    "/v1/student/attendance/complete": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Every attendance view in one call",
        "description": "Cumulative totals, the 12-month breakdown and the per-subject grid together \u2014 one request for a full attendance screen. Slower than the individual endpoints (~3-6 s).",
        "responses": {
          "200": {
            "description": "cumulative, byMonth, monthsWithLectures, bySubject",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceComplete"
                }
              }
            }
          }
        }
      }
    }
