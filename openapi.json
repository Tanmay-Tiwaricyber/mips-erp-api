{
  "openapi": "3.0.3",
  "info": {
    "title": "mips-erp-api",
    "version": "1.0.0",
    "description": "REST wrapper over the MPGI / MIPS Asteroid365 student portal (erp.mpgi.net). Generated from a live reverse-engineering session; every path below was exercised against the real portal."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Captcha + login"
    },
    {
      "name": "student",
      "description": "Student data"
    },
    {
      "name": "meta",
      "description": "Discovery"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "apiKey"
      },
      "sessionHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-ERP-Session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_CREDENTIALS"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Captcha": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "institute": {
            "type": "string"
          },
          "captchaImage": {
            "type": "string",
            "description": "data:image/jpeg;base64,..."
          },
          "ocrGuess": {
            "type": "string",
            "nullable": true,
            "description": "Server OCR guess (~33% accurate)"
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "example": "erp_xxxxxxxx"
          },
          "user": {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string"
              },
              "registrationCode": {
                "type": "string"
              },
              "profilePicUrl": {
                "type": "string"
              },
              "profileSigUrl": {
                "type": "string"
              }
            }
          },
          "role": {
            "type": "string",
            "example": "Student"
          },
          "institute": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "integer",
            "example": 1500
          },
          "captchaAttempts": {
            "type": "integer"
          },
          "solvedBy": {
            "type": "string",
            "enum": [
              "ocr",
              "client"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "registrationCode": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "rollNo": {
            "type": "string"
          },
          "program": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "semester": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "mobile": {
            "type": "string",
            "nullable": true
          },
          "raw": {
            "type": "object",
            "description": "All 210 fields as returned by the ERP"
          }
        }
      },
      "Subject": {
        "type": "object",
        "properties": {
          "serial": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "syllabusCoverage": {
            "type": "string"
          },
          "syllabusUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Timetable": {
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "periods": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "teacher": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "example": "LECTURE"
                      },
                      "slot": {
                        "type": "string"
                      },
                      "room": {
                        "type": "string",
                        "nullable": true
                      },
                      "type": {
                        "type": "string",
                        "example": "LUNCH"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Attendance": {
        "type": "object",
        "properties": {
          "overall": {
            "type": "object",
            "properties": {
              "percent": {
                "type": "number",
                "nullable": true
              },
              "present": {
                "type": "integer"
              },
              "absent": {
                "type": "integer"
              },
              "totalLectures": {
                "type": "integer"
              },
              "source": {
                "type": "string"
              },
              "month": {
                "type": "integer",
                "nullable": true,
                "description": "1-12 when ?month= was used, else null"
              }
            }
          },
          "bySubject": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "percent": {
                  "type": "number",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serial": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "attendance": {
                  "type": "string"
                },
                "midSemMarks": {
                  "type": "string"
                },
                "midSemMax": {
                  "type": "string"
                },
                "unitTest": {
                  "type": "string"
                }
              }
            }
          },
          "totals": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "Notice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "example": "05-Nov-2026"
          },
          "category": {
            "type": "string",
            "example": "ACADEMICS"
          },
          "isNew": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "html": {
            "type": "string"
          }
        }
      },
      "DailyAttendance": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "14-Nov-2026"
          },
          "weekday": {
            "type": "string",
            "example": "Saturday"
          },
          "markedDay": {
            "type": "string",
            "nullable": true,
            "description": "Row the ERP attached marks to"
          },
          "summary": {
            "type": "object",
            "properties": {
              "marked": {
                "type": "integer"
              },
              "present": {
                "type": "integer"
              },
              "absent": {
                "type": "integer"
              },
              "notMarked": {
                "type": "integer"
              },
              "percent": {
                "type": "number",
                "nullable": true
              }
            }
          },
          "periods": {
            "type": "array",
            "items": {
              "type": "object",
              "nullable": true,
              "properties": {
                "period": {
                  "type": "integer"
                },
                "slot": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "teacher": {
                  "type": "string",
                  "nullable": true
                },
                "room": {
                  "type": "string",
                  "nullable": true
                },
                "kind": {
                  "type": "string",
                  "example": "LECTURE"
                },
                "type": {
                  "type": "string",
                  "example": "LUNCH"
                },
                "attendance": {
                  "type": "string",
                  "nullable": true,
                  "enum": [
                    "present",
                    "absent",
                    null
                  ],
                  "description": "null = not marked yet"
                },
                "attendanceLabel": {
                  "type": "string",
                  "nullable": true,
                  "example": "Present"
                }
              }
            }
          },
          "present": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "absent": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "notMarked": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "MonthAttendance": {
        "type": "object",
        "properties": {
          "month": {
            "type": "integer",
            "example": 11
          },
          "monthName": {
            "type": "string",
            "example": "November"
          },
          "present": {
            "type": "integer",
            "example": 23
          },
          "absent": {
            "type": "integer",
            "example": 13
          },
          "total": {
            "type": "integer",
            "example": 36
          },
          "percent": {
            "type": "integer",
            "nullable": true,
            "example": 64
          }
        }
      },
      "AttendanceSummaryReport": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "cumulative",
              "month"
            ]
          },
          "month": {
            "type": "integer",
            "nullable": true
          },
          "monthName": {
            "type": "string",
            "nullable": true
          },
          "present": {
            "type": "integer",
            "example": 68
          },
          "absent": {
            "type": "integer",
            "example": 25
          },
          "total": {
            "type": "integer",
            "example": 93
          },
          "percent": {
            "type": "integer",
            "nullable": true,
            "example": 73,
            "description": "null when total is 0 \u2014 no marked lectures is not the same as 0%"
          },
          "byMonth": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthAttendance"
            }
          },
          "monthsWithLectures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "October",
              "November"
            ]
          }
        }
      },
      "SubjectAttendanceRow": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "the portal's own column \u2014 note it labels labs as 'Theory'"
          },
          "present": {
            "type": "integer"
          },
          "absent": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "percent": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "SubjectAttendanceReport": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "cumulative",
              "month"
            ]
          },
          "month": {
            "type": "integer",
            "nullable": true
          },
          "monthName": {
            "type": "string",
            "nullable": true
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectAttendanceRow"
            }
          },
          "overall": {
            "$ref": "#/components/schemas/AttendanceTotals"
          },
          "byType": {
            "type": "object",
            "properties": {
              "theory": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SubjectAttendanceRow"
                }
              },
              "lab": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SubjectAttendanceRow"
                }
              }
            }
          }
        }
      },
      "AttendanceTotals": {
        "type": "object",
        "properties": {
          "present": {
            "type": "integer"
          },
          "absent": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "percent": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "AttendanceComplete": {
        "type": "object",
        "properties": {
          "cumulative": {
            "$ref": "#/components/schemas/AttendanceTotals"
          },
          "byMonth": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthAttendance"
            }
          },
          "monthsWithLectures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bySubject": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectAttendanceRow"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "OCR availability, session counts and route list",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/institutes": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Known institute keys and ids",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/auth/captcha": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Step 1 \u2014 open a session and get a captcha image",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "institute": {
                    "type": "string",
                    "example": "MIPS"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Captcha issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Captcha"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Step 2 \u2014 log in (manual captcha, or ?auto=true for OCR + retries)",
        "parameters": [
          {
            "name": "auto",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Solve the captcha server-side with OCR and retry (captcha failures never count as failed logins)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "password"
                ],
                "properties": {
                  "userId": {
                    "type": "string",
                    "example": "2026BT0683"
                  },
                  "password": {
                    "type": "string"
                  },
                  "institute": {
                    "type": "string",
                    "example": "MIPS"
                  },
                  "sessionId": {
                    "type": "string",
                    "description": "From /v1/auth/captcha"
                  },
                  "captcha": {
                    "type": "string",
                    "description": "6-char answer you read from the image"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Wrong captcha \u2014 a fresh image is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bad credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "OCR exhausted its attempts \u2014 solve manually",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Current session identity",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "No/!invalid key"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Log out and discard the session",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/dashboard": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "All dashboard panels in one parallel call",
        "responses": {
          "200": {
            "description": "Panels, each wrapped as { ok, data }"
          }
        }
      }
    },
    "/v1/student/profile": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Student record",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/student/subjects": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Registered subjects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Subject"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/student/timetable": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Weekly timetable with teachers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Timetable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/student/attendance": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Attendance overall + per subject (real counts)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Attendance"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "BAD_MONTH"
          }
        },
        "description": "Per-subject percentages from the assessment grid, plus the true present/absent/totalLectures triple from the attendance report. Optional `?month=` scopes it to one month. For a richer breakdown use /v1/student/attendance/by-subject or /v1/student/attendance/summary.",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "0/all = cumulative (default), 1-12, or a month name",
            "schema": {
              "type": "string",
              "example": "11"
            }
          }
        ]
      }
    },
    "/v1/student/assessment": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Mid-sem / unit-test / assignment marks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Assessment"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/student/classmates": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Class list",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/student/documents": {
      "get": {
        "tags": [
          "student"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Important document links",
        "responses": {
          "200": {
            "description": "OK"
          }
