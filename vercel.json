{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [{ "src": "src/server.js", "use": "@vercel/node", "config": { "maxLambdaSize": "50mb" } }],
  "routes": [{ "src": "/(.*)", "dest": "src/server.js" }],
  "functions": { "src/server.js": { "memory": 1024, "maxDuration": 30 } }
}
